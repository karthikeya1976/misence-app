# Editor Club — Environment Variables
# Copy to .env and fill in your values. Never commit .env (it is gitignored).

# ── Database ───────────────────────────────────────────────────────────────────
# Local dev (docker-compose): postgresql://postgres:redactor123@localhost:5434/video_moderation
# AWS RDS:  postgresql://<user>:<pass>@<rds-endpoint>:5432/video_moderation
POSTGRES_URL=postgresql://postgres:redactor123@localhost:5434/video_moderation
POSTGRES_DB=video_moderation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ── Redis (Celery broker + backend) ───────────────────────────────────────────
# Local dev (docker-compose): redis://localhost:6380/0
# AWS ElastiCache: redis://<elasticache-endpoint>:6379/0
REDIS_URL=redis://localhost:6380/0

# ── AWS S3 (video storage) ─────────────────────────────────────────────────────
# On EC2 with an IAM instance profile, leave KEY/SECRET blank — boto3 uses the role.
AWS_S3_BUCKET=your-s3-bucket-name
AWS_S3_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Sightengine (adult content + AI/deepfake detection) ───────────────────────
# https://sightengine.com — free tier available
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── Legacy / local-only (not used on AWS) ─────────────────────────────────────
# UPLOAD_DIR is only used if storage.py falls back to local disk (not S3).
# Leave blank on AWS deployments.
UPLOAD_DIR=

# ── CloudWatch metrics (optional) ──────────────────────────────────────────────
# Set to publish VerdictLatencySeconds / QueueDepth / DeadLetterDepth. Leave blank locally.
# On EC2 the instance role needs cloudwatch:PutMetricData (granted in infra/cloudformation.yml).
CLOUDWATCH_NAMESPACE=
